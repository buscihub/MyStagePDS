<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pkgControl.GestioneProfiloCtrl" stylesheets="@../css/style.css">
    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-background-color: #333333; -fx-padding: 15px;">
            <Label text="ShareRoomAfam" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Stanze" onAction="#goToStanze" styleClass="primary-button"/>
            <Button text="Cerca Profili" onAction="#goToProfili" styleClass="primary-button"/>
            <Button text="Logout" onAction="#doLogout" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-padding: 8px 15px;"/>
        </HBox>
    </top>
    
    <center>
        <VBox alignment="CENTER" spacing="20.0" styleClass="main-container">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
            <Label text="Il Mio Profilo Artista" styleClass="title-label"/>
            
            <HBox spacing="30" alignment="CENTER">
                <VBox spacing="10">
                    <Label text="Nome d'Arte:" style="-fx-font-weight: bold;"/>
                    <Label text="Nome Artista Placeholder"/>
                </VBox>
                <VBox spacing="10">
                    <Label text="Anni di Carriera:" style="-fx-font-weight: bold;"/>
                    <Label text="5 anni"/>
                </VBox>
            </HBox>
            
            <Label text="Carica un nuovo documento" style="-fx-font-weight: bold; -fx-padding: 20px 0 0 0;"/>
            <Button text="Seleziona File..." onAction="#selezionaFile" styleClass="primary-button"/>
        </VBox>
    </center>
</BorderPane>
