<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pkgControl.AuthCtrl" stylesheets="@../css/style.css">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
    </padding>

    <Label text="Il Mio Profilo Artista" styleClass="title-label" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    
    <VBox spacing="10" alignment="CENTER">
        <Label text="Nome d'Arte:" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
        <Label fx:id="nomeArteLabel" text="..." style="-fx-font-size: 18px; -fx-text-fill: #007bff;"/>
    </VBox>
    
    <Region prefHeight="20"/>

    <VBox spacing="15" alignment="CENTER" maxWidth="300">
        <Button text="Gestione profilo" onAction="#goToGestioneProfilo_HomeCtrl" styleClass="primary-button" prefWidth="300"/>
        <Button text="Gestione stanze" onAction="#goToGestioneStanze_HomeCtrl" styleClass="secondary-button" prefWidth="300"/>
    </VBox>
</VBox>
