<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pkgControl.AuthCtrl" stylesheets="@../css/style.css" styleClass="main-container">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Registrazione Artista" styleClass="title-label"/>
    
    <VBox spacing="10.0" maxWidth="300">
        <TextField fx:id="nomeField" promptText="Nome" styleClass="input-field"/>
        <TextField fx:id="cognomeField" promptText="Cognome" styleClass="input-field"/>
        <DatePicker fx:id="dataNascitaField" promptText="Data di Nascita" styleClass="input-field" prefWidth="300"/>
        <ComboBox fx:id="sessoField" promptText="Sesso" styleClass="input-field" prefWidth="300"/>
        <TextField fx:id="codiceFiscaleField" promptText="Codice Fiscale" styleClass="input-field"/>
        <TextField fx:id="nomeDarteField" promptText="Nome d'Arte" styleClass="input-field"/>
        <TextField fx:id="carrieraField" promptText="Tipo di Carriera (Es. Musicista, Pittore...)" styleClass="input-field"/>
        <TextField fx:id="anniCarrieraField" promptText="Anni di Carriera (Es. 5)" styleClass="input-field"/>
        <TextField fx:id="emailField" promptText="Email" styleClass="input-field"/>
        <PasswordField fx:id="passwordField" promptText="Password" styleClass="input-field"/>
    </VBox>

    <Button text="Registrati" onAction="#handleRegistrazione" styleClass="primary-button"/>
    <Button text="Torna al Login" onAction="#goToLogin" styleClass="link-button"/>
</VBox>
