<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pkgControl.AuthCtrl" stylesheets="@../css/style.css" styleClass="main-container">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Gateway Autenticazione SPID" styleClass="title-label"/>
    <Label fx:id="providerLabel" text="Provider selezionato: " style="-fx-font-weight: bold;"/>
    
    <TextField fx:id="emailField" promptText="E-mail" styleClass="input-field"/>
    <PasswordField fx:id="passwordField" promptText="Password" styleClass="input-field"/>
    
    <Button text="Invia" onAction="#cliccaInviaSPID" styleClass="primary-button"/>
    <Button text="Annulla" onAction="#goToLogin" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-padding: 8px 15px;"/>
</VBox>
