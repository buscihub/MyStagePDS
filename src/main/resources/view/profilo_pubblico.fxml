<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pkgControl.ProfiloPubblicoCtrl" stylesheets="@../css/style.css" styleClass="main-container">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Profilo Artista" styleClass="title-label" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    
    <ImageView fx:id="avatarImage" fitHeight="100" fitWidth="100" preserveRatio="true"/>
    
    <GridPane vgap="5" hgap="10" alignment="CENTER" style="-fx-border-color: #cccccc; -fx-border-width: 1; -fx-padding: 10;">
        <Label text="Nome d'arte:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
        <Label fx:id="nomeArteLabel" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        
        <Label text="Nome:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
        <Label fx:id="nomeLabel" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        
        <Label text="Cognome:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
        <Label fx:id="cognomeLabel" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        
        <Label text="Sesso:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
        <Label fx:id="sessoLabel" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        
        <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-weight: bold;"/>
        <Label fx:id="emailLabel" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        
        <Label text="Carriere:" GridPane.columnIndex="0" GridPane.rowIndex="5" style="-fx-font-weight: bold;"/>
        <Label fx:id="carriereLabel" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
    </GridPane>
    
    <VBox alignment="CENTER_LEFT" maxWidth="400">
        <Label text="Documenti Caricati:" style="-fx-font-weight: bold;"/>
        <ListView fx:id="documentiPubbliciList" prefHeight="150" prefWidth="400" onMouseClicked="#apriDocumentoPubblico"/>
    </VBox>
    
    <Button text="Torna alla Ricerca" onAction="#goToRicerca" styleClass="secondary-button" prefWidth="400" style="-fx-background-color: #888888; -fx-text-fill: white;"/>
</VBox>
