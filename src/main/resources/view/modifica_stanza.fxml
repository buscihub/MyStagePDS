<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pkgControl.ModificaStanzaCtrl" stylesheets="@../css/style.css">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
    </padding>

    <Label text="Modifica Stanza" styleClass="title-label" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    <Label text="Seleziona l'operazione desiderata per questa stanza" style="-fx-font-size: 14px; -fx-text-fill: #666666;"/>
    
    <VBox spacing="10" alignment="CENTER" maxWidth="350">
        <Button text="Modifica nome stanza" onAction="#goToModificaNome" styleClass="secondary-button" prefWidth="350"/>
        <Button text="Aggiungi documenti" onAction="#goToAggiungiDocumenti" styleClass="secondary-button" prefWidth="350"/>
        <Button text="Rimuovi documenti" onAction="#goToRimuoviDocumenti" styleClass="secondary-button" prefWidth="350"/>
        <Button text="Rendi documento scaricabile/non scaricabile" onAction="#goToPermessiDocumenti" styleClass="secondary-button" prefWidth="350"/>
        <Region prefHeight="10"/>
        <Button text="Torna Indietro" onAction="#goToStanze" styleClass="secondary-button" prefWidth="350"/>
    </VBox>
</VBox>
