<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pkgControl.GestioneDocumentiStanzaCtrl" stylesheets="@../css/style.css">
    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-background-color: #333333; -fx-padding: 15px;">
            <Label fx:id="titoloLabel" text="Gestione Documenti Stanza" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Torna alle Stanze" onAction="#goToStanze" styleClass="primary-button"/>
        </HBox>
    </top>
    
    <center>
        <VBox alignment="CENTER" spacing="20.0" styleClass="main-container">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>

            <HBox spacing="20" alignment="CENTER">
                <VBox spacing="10" alignment="CENTER">
                    <Label text="I tuoi Documenti (Non in Stanza)" styleClass="title-label"/>
                    <TableView fx:id="documentiDisponibiliTable" prefHeight="300" prefWidth="350">
                        <columns>
                            <TableColumn fx:id="colNomeDisponibile" text="Nome File" prefWidth="250"/>
                            <TableColumn fx:id="colAggiungi" text="Aggiungi" prefWidth="90"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox spacing="10" alignment="CENTER">
                    <Label text="Documenti NELLA Stanza" styleClass="title-label"/>
                    <TableView fx:id="documentiStanzaTable" prefHeight="300" prefWidth="450">
                        <columns>
                            <TableColumn fx:id="colNomeStanza" text="Nome File" prefWidth="200"/>
                            <TableColumn fx:id="colScaricabile" text="Scaricabile" prefWidth="100"/>
                            <TableColumn fx:id="colRimuovi" text="Rimuovi" prefWidth="140"/>
                        </columns>
                    </TableView>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
