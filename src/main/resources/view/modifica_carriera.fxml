<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pkgControl.ModificaCarrieraCtrl" stylesheets="@../css/style.css">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
    </padding>

    <Label text="Modifica Carriera" styleClass="title-label" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Label text="Gestisci le tipologie di carriere e gli anni di esperienza." style="-fx-font-size: 14px; -fx-text-fill: #666666;"/>
    
    <VBox spacing="10" alignment="CENTER" maxWidth="300">
        <Button text="Aggiungi carriera" onAction="#goToAggiungiCarriera" styleClass="primary-button" style="-fx-background-color: #28a745;" prefWidth="300"/>
        <Button text="Rimuovi carriera" onAction="#goToRimuoviCarriera" style="-fx-text-fill: red; -fx-background-color: transparent; -fx-border-color: red; -fx-border-radius: 5px; -fx-padding: 8px;" prefWidth="300"/>
        <Region prefHeight="10"/>
        <Button text="Torna Indietro" onAction="#goBack" styleClass="secondary-button" prefWidth="300"/>
    </VBox>
</VBox>
