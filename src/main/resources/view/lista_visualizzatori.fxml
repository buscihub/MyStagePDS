<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pkgControl.ListaVisualizzatoriCtrl" stylesheets="@../css/style.css">
    
    <left>
        <VBox spacing="15.0" styleClass="sidebar">
            <Label text="Menu Artista" styleClass="sidebar-title"/>
            <Button text="Il Mio Profilo" onAction="#goToProfilo" styleClass="sidebar-button"/>
            <Button text="Le Mie Stanze" onAction="#goToStanze" styleClass="sidebar-button"/>
            <Region VBox.vgrow="ALWAYS" />
            <Button text="Esci" onAction="#handleLogout" styleClass="sidebar-button"/>
        </VBox>
    </left>
    
    <center>
        <VBox alignment="CENTER" spacing="20.0" styleClass="main-container">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>

            <Label fx:id="titoloLabel" text="Statistiche Stanza" styleClass="title-label"/>
            
            <TableView fx:id="statisticheTable" prefHeight="400" prefWidth="600" maxWidth="600">
                <columns>
                    <TableColumn fx:id="colNome" text="Nome" prefWidth="150"/>
                    <TableColumn fx:id="colCognome" text="Cognome" prefWidth="150"/>
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="180"/>
                    <TableColumn fx:id="colData" text="Data Visualizzazione" prefWidth="120"/>
                </columns>
            </TableView>
            
            <HBox alignment="CENTER_RIGHT">
                <Button text="Torna alle Stanze" onAction="#goToStanze" styleClass="secondary-button"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
