<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pkgControl.VisualizzaProfiliCtrl" stylesheets="@../css/style.css">
    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-background-color: #333333; -fx-padding: 15px;">
            <Label text="Ricerca Artisti" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Torna al Mio Profilo" onAction="#goToProfilo" styleClass="primary-button"/>
        </HBox>
    </top>
    
    <center>
        <VBox alignment="CENTER" spacing="20.0" styleClass="main-container">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
            <Label text="Cerca altri professionisti" styleClass="title-label"/>
            
            <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="searchField" promptText="Cerca per nome o professione..." styleClass="input-field" prefWidth="300"/>
                <Button text="Cerca" onAction="#cercaProfili" styleClass="primary-button"/>
            </HBox>
            
            <ListView fx:id="profiliList" prefHeight="300" prefWidth="500" onMouseClicked="#onProfiloClicked" />
        </VBox>
    </center>
</BorderPane>
