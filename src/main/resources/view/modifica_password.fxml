<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pkgControl.ModificaPasswordCtrl" stylesheets="@../css/style.css">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
    </padding>

    <Label text="Cambia Password" styleClass="title-label" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Label text="Inserisci la nuova password:" style="-fx-font-size: 14px;"/>
    
    <VBox spacing="10" alignment="CENTER" maxWidth="300">
        <PasswordField fx:id="nuovaPasswordField" promptText="Nuova password" styleClass="input-field" prefWidth="300"/>
        <PasswordField fx:id="confermaPasswordField" promptText="Conferma nuova password" styleClass="input-field" prefWidth="300"/>
        <Region prefHeight="10"/>
        <Button text="Conferma" onAction="#conferma" styleClass="primary-button" prefWidth="300"/>
        <Button text="Annulla" onAction="#annulla" styleClass="secondary-button" prefWidth="300"/>
    </VBox>
</VBox>
