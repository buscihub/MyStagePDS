<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pkgControl.GestisciDocumentiCtrl" stylesheets="@../css/style.css">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
    </padding>

    <Label text="Gestisci Documenti" styleClass="title-label" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    <Label text="Carica, elimina o modifica la visibilità dei tuoi file" style="-fx-font-size: 14px; -fx-text-fill: #666666;"/>
    
    <VBox spacing="10" alignment="CENTER" maxWidth="300">
        <Button text="Carica documenti" onAction="#selezionaFile" styleClass="primary-button" prefWidth="300"/>
        <Button text="Elimina documenti" onAction="#goToEliminaDocumenti" styleClass="secondary-button" prefWidth="300"/>
        <Button text="Cambia stato documenti" onAction="#goToCambiaStato" styleClass="secondary-button" prefWidth="300"/>
        <Region prefHeight="10"/>
        <Button text="Torna Indietro" onAction="#goBack" styleClass="secondary-button" prefWidth="300"/>
    </VBox>
</VBox>
