<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pkgControl.AuthCtrl" style="-fx-background-color: #f4f4f4;">
    <padding>
        <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
    </padding>

    <Label text="Autenticazione a due fattori" style="-fx-font-weight: bold; -fx-text-fill: #333333;">
        <font>
            <Font size="24.0" />
        </font>
    </Label>

    <Label text="Inserisci il codice che ti abbiamo inviato via e-mail." style="-fx-text-fill: #666666;">
        <font>
            <Font size="14.0" />
        </font>
    </Label>

    <TextField fx:id="codiceField" promptText="Codice OTP" maxWidth="300" style="-fx-font-size: 16px; -fx-padding: 10px; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-border-color: #cccccc;"/>

    <Button text="Invia" onAction="#handleInvia_InserisciCodiceCtrl" maxWidth="300" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 10px; -fx-background-radius: 5px; -fx-font-weight: bold; -fx-cursor: hand;" />

    <Button text="Torna Indietro" onAction="#handleTornaIndietro_InserisciCodiceCtrl" maxWidth="300" style="-fx-background-color: transparent; -fx-text-fill: #007bff; -fx-font-size: 14px; -fx-cursor: hand;" />
</VBox>
