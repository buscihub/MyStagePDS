<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pkgControl.VistaScouterCtrl" stylesheets="@../css/style.css">
    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-background-color: #333333; -fx-padding: 15px;">
            <Label text="Area Guest - MyStage" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Esci / Torna al Login" onAction="#handleEsci" styleClass="secondary-button"/>
        </HBox>
    </top>
    
    <center>
        <VBox alignment="CENTER" spacing="20.0" styleClass="main-container">
            <!-- Artist Info -->
            <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 20px; -fx-background-radius: 5px; -fx-border-color: #e0e0e0; -fx-border-radius: 5px;" maxWidth="600">
                <ImageView fx:id="imgProfilo" fitHeight="120" fitWidth="120" preserveRatio="true"/>
                <VBox spacing="8" alignment="CENTER_LEFT">
                    <Label fx:id="nomeLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0066cc;"/>
                    
                    <HBox spacing="5">
                        <Label text="Data di nascita:" style="-fx-font-weight: bold; -fx-text-fill: #555555;"/>
                        <Label fx:id="dataNascitaLabel" style="-fx-text-fill: #555555;"/>
                    </HBox>
                    
                    <HBox spacing="5">
                        <Label text="Email:" style="-fx-font-weight: bold; -fx-text-fill: #555555;"/>
                        <Label fx:id="emailLabel" style="-fx-text-fill: #555555;"/>
                    </HBox>
                    
                    <Label text="Carriere:" style="-fx-font-weight: bold; -fx-text-fill: #555555;"/>
                    <VBox fx:id="carriereContainer" spacing="2" alignment="CENTER_LEFT"/>
                </VBox>
            </HBox>

            <Label fx:id="titoloStanzaLabel" text="Contenuto della Stanza" styleClass="title-label" style="-fx-font-size: 18px;"/>
            
            <TableView fx:id="documentiTable" prefHeight="400" prefWidth="600" maxWidth="600">
                <columns>
                    <TableColumn fx:id="colNomeFile" text="Nome Documento" prefWidth="300"/>
                    <TableColumn fx:id="colAzioni" text="Azioni" prefWidth="280"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
