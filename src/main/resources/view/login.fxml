<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pkgControl.AuthCtrl" stylesheets="@../css/style.css" styleClass="main-container">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="MyStage" styleClass="title-label"/>
    
    <VBox spacing="10.0" maxWidth="300">
        <Label text="Email"/>
        <TextField fx:id="emailField" promptText="Inserisci la tua email" styleClass="input-field"/>
        
        <Label text="Password"/>
        <PasswordField fx:id="passwordField" promptText="Inserisci la tua password" styleClass="input-field"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Accedi" onAction="#handleLogin" styleClass="primary-button"/>
        <Button text="Entra con SPID" onAction="#handleSPID" style="-fx-background-color: #005A9C; -fx-text-fill: white;"/>
    </HBox>
    <Button text="Hai dimenticato la password? Recuperala" onAction="#handleRecuperaPassword" styleClass="link-button"/>
    <Button text="Non hai un account? Registrati" onAction="#goToRegistrazione" styleClass="link-button"/>

    <Separator />
    
    <Label text="Sei uno Scouter?" style="-fx-font-weight: bold;"/>
    <HBox spacing="10" alignment="CENTER" maxWidth="400">
        <TextField fx:id="linkStanzaField" promptText="Es. mystage.com/1234abcd" HBox.hgrow="ALWAYS" styleClass="input-field"/>
        <Button text="Vai alla Stanza" onAction="#handleGuestLogin" styleClass="secondary-button"/>
        <Button text="Visualizza profili" onAction="#cercaArtistiGuest" styleClass="secondary-button"/>
    </HBox>
</VBox>
