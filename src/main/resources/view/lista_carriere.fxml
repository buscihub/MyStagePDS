<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pkgControl.ModificaCarrieraCtrl" stylesheets="@../css/style.css">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
    </padding>

    <Label text="Rimuovi Carriere" styleClass="title-label" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Label text="Seleziona le carriere che vuoi cancellare dal profilo" style="-fx-font-size: 14px; -fx-text-fill: #666666;"/>
    
    <VBox spacing="10" alignment="CENTER" maxWidth="350">
        <ListView fx:id="carriereListView" prefHeight="200" prefWidth="350" style="-fx-border-color: #cccccc; -fx-border-radius: 5px;"/>
        <Region prefHeight="10"/>
        <Button text="Conferma" onAction="#conferma" styleClass="primary-button" style="-fx-background-color: #dc3545;" prefWidth="350"/>
        <Button text="Annulla" onAction="#annulla_ListaCarriereCtrl" styleClass="secondary-button" prefWidth="350"/>
    </VBox>
</VBox>
